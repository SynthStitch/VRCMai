# VPM packages (restored by VCC from vpm-manifest.json)
/Packages/*/
!/Packages/manifest.json
!/Packages/packages-lock.json
!/Packages/vpm-manifest.json

# third-party content, not redistributed
/Assets/Maimai/Charts/
/Assets/Maimai/Charts.meta

# build leftovers (regenerated)
/Assets/_LastBuild/
/Assets/_LastBuild.meta
/Assets/_LockedShaderCache/
/Assets/_LockedShaderCache.meta

# AstroDX sample skin (no license, local only)
/Assets/Maimai/Skin/
/Assets/Maimai/Skin.meta

/Assets/Scenes/MaiWorld/
/Assets/Scenes/MaiWorld.meta


# streamed-song site output (published separately once songs are approved)
/Stream/site/

# the world itself (scene + cabinet model) stays local; the repo is the system only
/Assets/Scenes/MaiWorld.unity
/Assets/Scenes/MaiWorld.unity.meta
/Tests/**/bin/
/Tests/**/obj/
